# Large/external data -- see README.md for how to re-download or
# regenerate everything excluded here. Nothing below is our own authored
# work; it's either a third-party download (hg38 genome, ENCODE ChIP-seq/
# ATAC-seq/RNA-seq, pretrained model weights, the paper's own DeepTFBU
# repo clone) or a generated intermediate/output artifact.
data/*
!data/processed/
data/processed/*
!data/processed/jaspar_pfms.json
!data/processed/tf_pfm_ids.csv
!data/processed/tf_to_ensembl.json

# generated outputs from the pipeline (regenerated by running the CLI)
estfbu_workdir/
estfbu_workdir_quickstart/

# run logs (transient, often large text dumps of long-running jobs)
logs/

# preliminary reproduction work + superseded early prototype + full
# development log -- kept locally, not part of the published pipeline
# (small excerpts of results/findings live in ref_result/ instead)
archive/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# OS/editor cruft
.DS_Store
.vscode/
.idea/
